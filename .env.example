# Database Configuration
# PostgreSQL connection string for Prisma
POSTGRES_URL="postgresql://user:password@localhost:5432/promptmetheus?schema=public"
DATABASE_URL="postgresql://user:password@localhost:5432/promptmetheus?schema=public"

# Supabase Configuration
# Get these from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Kinde Authentication
# Get these from your Kinde application settings
KINDE_CLIENT_ID="your-kinde-client-id"
KINDE_CLIENT_SECRET="your-kinde-client-secret"
KINDE_ISSUER_URL="https://your-domain.kinde.com"
KINDE_SITE_URL="http://localhost:3000"
KINDE_POST_LOGOUT_REDIRECT_URL="http://localhost:3000"
KINDE_POST_LOGIN_REDIRECT_URL="http://localhost:3000"

# LLM API Keys
# OpenAI API Key for GPT models
OPENAI_API_KEY="sk-your-openai-api-key"

# Anthropic API Key for Claude models
ANTHROPIC_API_KEY="sk-ant-your-anthropic-api-key"

# Google AI API Key for Gemini models
GOOGLE_AI_API_KEY="your-google-ai-api-key"

# Qwen/Alibaba Cloud API Key
QWEN_API_KEY="your-qwen-api-key"

# Application Configuration
# Admin email addresses (comma-separated)
ADMIN_EMAILS="admin@example.com,another-admin@example.com"

# Daily token limit per user
DAILY_TOKEN_LIMIT="100000"

# Rate limiting
RATE_LIMIT_REQUESTS_PER_MINUTE="60"
RATE_LIMIT_REQUESTS_PER_HOUR="1000"

# Encryption
# Generate a secure random string for encryption (32+ characters)
ENCRYPTION_KEY="your-secure-encryption-key-min-32-chars"

# Environment
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Vercel Analytics (optional)
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=""

# Feature Flags
ENABLE_MOCK_RESPONSES="false"
ENABLE_RATE_LIMITING="true"
ENABLE_AUDIT_LOGGING="true"

# Session Configuration
SESSION_TIMEOUT_MINUTES="30"
MAX_CONCURRENT_USERS="5"

# File Upload Configuration
MAX_FILE_SIZE_MB="3"
ALLOWED_FILE_TYPES=".jpg,.png,.svg,.js,.ts,.jsx,.tsx,.css,.html,.fig,.sketch"
