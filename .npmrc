# Package Security Configuration
# Enable package lock to ensure consistent installations
package-lock=true

# Verify package integrity using checksums
package-lock-only=false

# Save exact versions in package.json (no ^ or ~)
save-exact=true

# Audit packages on install
audit=true

# Set audit level (low, moderate, high, critical)
audit-level=moderate

# Automatically fix vulnerabilities when possible
# Set to false in production for manual review
audit-fix=false

# Prevent automatic updates
save-prefix=""

# Use legacy peer deps to avoid conflicts (Next.js 14 compatibility)
legacy-peer-deps=true

# Engine strict mode - enforce Node version from package.json
engine-strict=true

# Progress indicator
progress=true

# Logging level
loglevel=warn

# Registry configuration (use official npm registry)
registry=https://registry.npmjs.org/

# Timeout settings (in milliseconds)
fetch-timeout=60000
fetch-retries=3
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000
